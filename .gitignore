.env.local
.env.development
.env.production
.env.staging

# Flutter / Mobile
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
.fvm/

# IDE/Editor files (IntelliJ, VS Code, etc)
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Android Specific
.gradle/
local.properties
key.properties
app/debug/
app/profile/
app/release/

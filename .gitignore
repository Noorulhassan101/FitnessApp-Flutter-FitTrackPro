*.keystore
GeneratedPluginRegistrant.java

# iOS Specific
.symlinks/
Pods/
App.framework
Flutter.framework
Generated.xcconfig
flutter_export_environment.sh
GeneratedPluginRegistrant.*

# Google Services / API Keys / Secrets
google-services.json
GoogleService-Info.plist
**/google-services.json
**/GoogleService-Info.plist
*.env*
**/*.env*
